NODE_ENV=development
PORT=4000
# Frontend origin allowed to send credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000

# API docs at /api/docs. Defaults to on, except when NODE_ENV=production.
# SWAGGER_ENABLED=false

# Matches docker-compose.yml
DATABASE_URL=postgres://jingabel:jingabel@localhost:5433/jingabel

# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes in seconds (15 minutes / 7 days)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Frontend URL used for links in emails (no trailing slash)
APP_URL=http://localhost:3000
# Invitation link lifetime in seconds (7 days)
INVITATION_TTL=604800
# Forgot-password link lifetime in seconds (1 hour)
PASSWORD_RESET_TTL=3600

# Outgoing mail over SMTP (nodemailer). Required in production. Leave SMTP_HOST
# empty in development to log emails (with their links) instead of sending them.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS from the start); false uses STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jingabel <no-reply@jingabel.local>"
